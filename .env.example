# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# Set to your AWS Amplify URL or React local URL:
# Example: http://localhost:5173 or https://main.d12345.amplifyapp.com (or * for all)
FRONTEND_URL=*

# AWS Service Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=clouddrop-storage-demo
DYNAMODB_TABLE_NAME=CloudDropFiles

# AWS Credentials (Optional for local development)
# On EC2 with IAM Instance Profile, LEAVE EMPTY! The AWS SDK retrieves credentials automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
