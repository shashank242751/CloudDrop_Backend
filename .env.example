PORT=3000
AWS_REGION=us-east-1
S3_BUCKET_NAME=clouddrop-storage-demo-unique-id
DYNAMODB_TABLE_NAME=CloudDropFiles
# When running on EC2 with IAM Instance Profile, leave AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY empty!
# AWS SDK automatically uses IAM Instance Profile credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

